# Copy to .env and fill in. Supabase dashboard -> your project -> Settings -> API.
#
# The EXPO_PUBLIC_ prefix means these are compiled into the app bundle and are
# readable by anyone who unzips a build. That is correct for both values below:
# the anon key is designed to be public, and security comes from the Row Level
# Security policies in scripts/supabase_schema.sql. Never put a password, a
# service-role key, or any other secret behind this prefix.
#
# Leave these unset and the app runs fully offline — accounts and sync simply
# don't appear (see lib/supabase.js).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_ANON_KEY
