      "example": "# <Axes: xlabel='date'>",
      "starterCode": "ts.set_index('date')['revenue'].___()",
      "expectedOutput": "",
      "tokens": ["plot"],
      "distractors": ["chart", "draw", "graph"],
      "chart": {
        "kind": "line",
        "title": "Daily revenue",
        "xLabel": "date",
        "yLabel": "revenue",
        "categories": [
          "Jan 1", "Jan 2", "Jan 3", "Jan 4", "Jan 5",
          "Jan 6", "Jan 7", "Jan 8", "Jan 9", "Jan 10",
          "Jan 11", "Jan 12", "Jan 13", "Jan 14"
        ],
        "series": [
          { "name": "revenue", "values": [120, 95, 80, 60, 45, 70, 50, 65, 90, 110, 75, 55, 85, 100] }
        ]
      }
    },
